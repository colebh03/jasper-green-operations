@model Service

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Invoice</title>

    <style>
        body {
            margin: 0;
            padding: 40px;
            background-color: #f4f7f3;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1f2937;
        }

        .invoice-container {
            max-width: 950px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            padding: 55px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.08);
        }

        .top-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 55px;
        }

        .brand-name {
            font-size: 34px;
            font-weight: 700;
            color: #4CAF50;
            margin-bottom: 8px;
        }

        .brand-subtitle {
            color: #6b7280;
            font-size: 15px;
        }

        .invoice-heading {
            text-align: right;
        }

            .invoice-heading h1 {
                margin: 0;
                font-size: 44px;
                color: #111827;
            }

        .invoice-number {
            margin-top: 8px;
            font-size: 15px;
            color: #6b7280;
        }

        .invoice-date {
            margin-top: 4px;
            font-size: 15px;
            color: #6b7280;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 35px;
            margin-bottom: 50px;
        }

        .info-card {
            background: #f9fafb;
            border-radius: 16px;
            padding: 26px;
        }

        .section-title {
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #4CAF50;
            font-weight: 700;
            margin-bottom: 14px;
        }

        .info-card strong {
            display: block;
            font-size: 20px;
            margin-bottom: 10px;
            color: #111827;
        }

        .info-card p {
            margin: 5px 0;
            color: #4b5563;
            line-height: 1.6;
        }

        .status-badge {
            display: inline-block;
            margin-top: 16px;
            padding: 10px 18px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .status-paid {
            background: rgba(76, 175, 80, 0.15);
            color: #4CAF50;
        }

        .status-unpaid {
            background: rgba(245, 158, 11, 0.16);
            color: #d97706;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 45px;
        }

        thead {
            background: #f3f4f6;
        }

        th {
            padding: 16px;
            text-align: left;
            font-size: 12px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #4b5563;
        }

        td {
            padding: 20px 16px;
            border-bottom: 1px solid #e5e7eb;
            color: #374151;
        }

        .amount-column {
            text-align: right;
        }

        .summary-wrapper {
            display: flex;
            justify-content: flex-end;
        }

        .summary-box {
            width: 340px;
            background: #f9fafb;
            border-radius: 16px;
            padding: 28px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 14px;
            color: #4b5563;
            font-size: 15px;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            margin-top: 24px;
            padding-top: 22px;
            border-top: 2px solid #d1d5db;
            font-size: 30px;
            font-weight: 700;
            color: #111827;
        }

        .footer {
            margin-top: 65px;
            text-align: center;
            color: #9ca3af;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <div class="invoice-container">

        <div class="top-section">

            <div>
                <div class="brand-name">
                    Jasper Green Lawn Care
                </div>

                <div class="brand-subtitle">
                    Professional Lawn Maintenance Services
                </div>
            </div>

            <div class="invoice-heading">

                <h1>Invoice</h1>

                <div class="invoice-number">
                    @ViewBag.InvoiceNumber
                </div>

                <div class="invoice-date">
                    Issued:
                    @DateTime.Now.ToShortDateString()
                </div>

            </div>

        </div>

        <div class="info-grid">

            <div class="info-card">

                <div class="section-title">
                    Bill To
                </div>

                <strong>
                    @Model.Customer.Cust_Name
                </strong>

                <p>
                    @Model.Customer.Cust_Billing_Address
                </p>

                <p>
                    @Model.Customer.Cust_Billing_City,
                    @Model.Customer.Cust_Billing_State
                    @Model.Customer.Cust_Billing_Zip
                </p>

                <p>
                    @String.Format(
                        "{0:(###) ###-####}",
                        Convert.ToInt64(Model.Customer.Cust_Phone))
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Customer.Cust_Email))
                {
                    <p>
                        @Model.Customer.Cust_Email
                    </p>
                }

            </div>

            <div class="info-card">

                <div class="section-title">
                    Service Details
                </div>

                <strong>
                    @Model.Property.Property_Full_Address
                </strong>

                <p>
                    Service Date:
                    @Model.Service_Date.ToShortDateString()
                </p>

                <p>
                    Crew Foreman:
                    @Model.Crew.Foreman.Emp_First_Name
                    @Model.Crew.Foreman.Emp_Last_Name
                </p>

                @if (Model.Payment != null)
                {
                    <p>
                        Payment Date:
                        @Model.Payment.Payment_Date.ToShortDateString()
                    </p>

                    <p>
                        Payment Method:
                        @Model.Payment.Payment_Method
                    </p>

                    <div class="status-badge status-paid">
                        Paid
                    </div>
                }
                else
                {
                    <div class="status-badge status-unpaid">
                        Unpaid
                    </div>
                }

            </div>

        </div>

        <table>

            <thead>
                <tr>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th class="amount-column">Rate</th>
                    <th class="amount-column">Amount</th>
                </tr>
            </thead>

            <tbody>
                <tr>

                    <td>
                        Lawn Maintenance Service
                    </td>

                    <td>
                        1
                    </td>

                    <td class="amount-column">
                        @Model.Service_Fee.ToString("C")
                    </td>

                    <td class="amount-column">
                        @Model.Service_Fee.ToString("C")
                    </td>

                </tr>
            </tbody>

        </table>

        <div class="summary-wrapper">

            <div class="summary-box">

                <div class="summary-row">
                    <span>Subtotal</span>

                    <span>
                        @Model.Service_Fee.ToString("C")
                    </span>
                </div>

                <div class="summary-row">
                    <span>Tax</span>

                    <span>$0.00</span>
                </div>

                <div class="summary-total">
                    <span>Total</span>

                    <span>
                        @Model.Service_Fee.ToString("C")
                    </span>
                </div>

            </div>

        </div>

        <div class="footer">
            Thank you for choosing Jasper Green Lawn Care.
        </div>

    </div>

</body>
</html>