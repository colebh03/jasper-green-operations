AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      Delete.cshtml (Service Delete Confirmation View)

PURPOSE:      Displays a confirmation page before deleting a service event.
              Ensures the user verifies the action before permanent removal.

INPUT:        - Service model passed from the controller
              - Service details (Date, Property, Crew, Fee) for display

PROCESS:      - Displays key service event information for user confirmation
              - Posts back to Delete action upon confirmation
              - Provides option to cancel and return to list

OUTPUT:       - Rendered confirmation page with service event details
              - Form submission to delete record or cancel action

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model Service

@{
    // Set the page title for display in the layout and browser tab.
    string title = "Delete Service Event";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Confirm Deletion</h2>
</div>
    <!-- Warning message displayed prominently to alert the user -->
    <p class="bg-danger text-light p-3">
        Are you sure you want to delete the following service event from the database?
    </p>

    <!-- Display the property address so the user knows which record is affected -->
    <h3>@Model.Service_Date.ToShortDateString() - @Model.Property.Property_Address</h3>
    <h3>@Model.Crew.CrewDisplayShort — @Model.Service_Fee.ToString("C")</h3>

    <!--
        The form posts to the Delete action method in the controller.
        A hidden field is used to pass the Property_ID so the correct record
        can be located and removed.
    -->
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Service_ID" />

        <!-- Confirmation buttons: Delete (submits) or Cancel (returns to list) -->
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
    </form>
