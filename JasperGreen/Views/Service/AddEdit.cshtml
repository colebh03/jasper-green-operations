@model ServiceViewModel

@{    
    string title = Model.Action + " Service Event";
    ViewData["Title"] = title;
}

<div class="mx-auto" style="max-width: 900px;">
    <h2 class="mt-3 mb-3">@ViewData["Title"]</h2>

    <div class="card-box shadow-sm p-3 mx-auto" style="max-width: 900px;">
        <form asp-action="Save" method="post">
            <div class="row mb-2">
                <label asp-for="Service.Crew_ID" class="col-md-3 col-form-label">Crew</label>
                <div class="col-md-7">
                    <select asp-for="Service.Crew_ID" asp-items="@(new SelectList(Model.Crews, "Crew_ID", "CrewDisplayLong"))" class="form-select">
                        <option value="">Select a crew...</option>
                    </select>
                    <span asp-validation-for="Service.Crew_ID" class="text-danger"></span>
                </div>
            </div>   

            <div class="row mb-2">
                <label asp-for="Service.Cust_ID" class="col-md-3 col-form-label">Customer</label>
                <div class="col-md-7">
                    <select id="customerSelect" asp-for="Service.Cust_ID" asp-items="@(new SelectList(Model.Customers, "Cust_ID", "Cust_Name"))" class="form-select">
                        <option value="">Select a customer...</option>
                    </select>
                    <span asp-validation-for="Service.Cust_ID" class="text-danger"></span>
                </div>
            </div>

            @* Property options are loaded dynamically after a customer is selected. *@
            <div class="row mb-2">
                <label asp-for="Service.Property_ID" class="col-md-3 col-form-label">Property</label>
                <div class="col-md-7">
                    <select id="propertySelect"
                        asp-for="Service.Property_ID"
                        class="form-select"
                        disabled>
                        <option value="">Select a property...</option>
                    </select>
                    <span asp-validation-for="Service.Property_ID" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Service.Service_Date" class="col-md-3 col-form-label">Service Date</label>
                <div class="col-md-7">
                    <input asp-for="Service.Service_Date" class="form-control" type="date" />
                    <span asp-validation-for="Service.Service_Date" class="text-danger"></span>
                </div>
            </div>         

            <div class="row mb-2">
                <label asp-for="Service.Service_Fee" class="col-md-3 col-form-label">Service Fee</label>
                <div class="col-md-7">
                    <input asp-for="Service.Service_Fee" class="form-control" />
                    <span asp-validation-for="Service.Service_Fee" class="text-danger"></span>
                </div>
            </div>            

            <input type="hidden" asp-for="Service.Service_ID" />

            <div class="mt-3">
                <button type="submit" class="btn btn-green">Save</button>
                <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Reload the property dropdown whenever the selected customer changes
    document.getElementById("customerSelect").addEventListener("change", function () {

        const customerId = this.value;
        const propertyDropdown = document.getElementById("propertySelect");
        const currentPropertyId = "@Model.Service.Property_ID";

        propertyDropdown.disabled = true;

        propertyDropdown.innerHTML =
            '<option value="">Select a property...</option>';

        if (customerId === "") {
            propertyDropdown.disabled = true;
            return;
        }

        fetch(`/Service/GetPropertiesByCustomer?customerId=${customerId}`)
            .then(response => response.json())
            .then(data => {

                propertyDropdown.disabled = false;

                data.forEach(property => {

                    const option = document.createElement("option");

                    option.value = property.property_ID;
                    option.text = property.fullAddress;

                    if (property.property_ID == currentPropertyId) {
                        option.selected = true;
                    }

                    propertyDropdown.appendChild(option);
                });
            });
    });

    // Repopulate properties on page load when editing an existing service
    window.addEventListener("load", function () {

        const customerDropdown =
            document.getElementById("customerSelect");

        if (customerDropdown.value !== "") {
            customerDropdown.dispatchEvent(new Event("change"));
        }
    });

</script>