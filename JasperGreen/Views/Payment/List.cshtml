@model PaymentListViewModel
@*  Display payment-related errors *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Payments</h2>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">

    <div class="dropdown">
        <button class="btn btn-green dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Filter
        </button>

        @if (!string.IsNullOrEmpty(Model.CurrentFilterText))
        {
            <div class="mt-2">
                <a asp-action="List" class="filter-tag">
                    <span>@Model.CurrentFilterText</span>
                    <i class="bi bi-x"></i>
                </a>
            </div>
        }

        <ul class="dropdown-menu">
            <li>
                <a class="dropdown-item" asp-action="GetDate">By Date</a>
            </li>
            <li>
                <a class="dropdown-item" asp-action="GetCustomer">By Customer</a>
            </li>            

            <li><hr class="dropdown-divider"></li>

            <li>
                <a class="dropdown-item text-muted" asp-action="List">Show All</a>
            </li>
        </ul>
    </div>

</div>

<div class="card-table shadow-sm p-0">
    <div class="table-responsive">
        <table class="table align-middle table-hover table-actions">
            <thead class="table-light">
                <tr>      
                    <th>
                        <span>Date</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="date"
                           asp-route-sortDirection="@(Model.SortColumn == "date"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 px-1">

                            @if (Model.SortColumn == "date")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle text-secondary"></i>
                            }

                        </a>
                    </th>

                    <th>
                        <span>Customer</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="name"
                           asp-route-sortDirection="@(Model.SortColumn == "name" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "name")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>

                    <th>
                        <span>Amount</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="amount"
                           asp-route-sortDirection="@(Model.SortColumn == "amount"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "amount")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>                    

                    <th>
                        <span>Method</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="method"
                           asp-route-sortDirection="@(Model.SortColumn == "method" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "method")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>

                    <th>
                        <span>Payment ID</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="paymentid"
                           asp-route-sortDirection="@(Model.SortColumn == "paymentid"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "paymentid")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>

                    <th style="width: 160px;"></th>                    
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>                                           
                        <td>@payment.Payment_Date.ToShortDateString()</td>
                        <td>@payment.Service.Customer.Cust_Name</td>
                        <td>@payment.Payment_Amount.ToString("c")</td>                       
                        <td>@payment.Payment_Method</td>
                        <td>@payment.Payment_ID.ToString("D8")</td>
                        
                        <td class="text-end">                           
                            <div class="d-inline-flex align-items-center gap-3">
                                <a asp-action="Edit" asp-route-id="@payment.Payment_ID" class="text-muted" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>                                
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>    
</div>