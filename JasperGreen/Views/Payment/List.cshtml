@*
============================================================================
AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      List.cshtml (Payment Manager View)

PURPOSE:      Displays a list of all Payment records in a tabular format.
              Provides options to add, edit, and delete payments.

INPUT:        - List<Payment> model passed from the controller
              - TempData["Error"] for displaying deletion-related messages

PROCESS:      - Iterates through Payment records to populate table rows
              - Formats dates and currency for display
              - Conditionally displays error message if present
              - Generates action links for Edit and Delete operations

OUTPUT:       - Rendered HTML table of payments
              - Navigation links for Add, Edit, and Delete actions
              - Error alert if deletion is restricted

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model PaymentListViewModel
<!-- Error for deletion of property when associated with service records -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Payments</h2>              
    @* <a asp-action="Add" class="btn btn-green">+ Add Payment</a> *@
</div>

<div class="d-flex justify-content-between align-items-center mb-3">

    <div class="dropdown">
        <button class="btn btn-green dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Filter
        </button>

        @if (!string.IsNullOrEmpty(Model.CurrentFilterText))
        {
            <div class="mt-2">
                <a asp-action="List" class="filter-tag">
                    <span>@Model.CurrentFilterText</span>
                    <i class="bi bi-x"></i>
                </a>
            </div>
        }

        <ul class="dropdown-menu">
            <li>
                <a class="dropdown-item" asp-action="GetDate">By Date</a>
            </li>
            <li>
                <a class="dropdown-item" asp-action="GetCustomer">By Customer</a>
            </li>            

            <li><hr class="dropdown-divider"></li>

            <li>
                <a class="dropdown-item text-muted" asp-action="List">Show All</a>
            </li>
        </ul>
    </div>

</div>

<div class="card-table shadow-sm p-0">
    <div class="table-responsive">
        <table class="table align-middle table-hover table-actions">
            <thead class="table-light">
                <tr>      
                    <th>
                        <span>Date</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="date"
                           asp-route-sortDirection="@(Model.SortColumn == "date"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 px-1">

                            @if (Model.SortColumn == "date")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle text-secondary"></i>
                            }

                        </a>
                    </th>

                    <th>
                        <span>Customer</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="name"
                           asp-route-sortDirection="@(Model.SortColumn == "name" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "name")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>

                    <th>
                        <span>Amount</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="amount"
                           asp-route-sortDirection="@(Model.SortColumn == "amount"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "amount")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>                    

                    <th>
                        <span>Method</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="method"
                           asp-route-sortDirection="@(Model.SortColumn == "method" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "method")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>

                    <th>
                        <span>Payment ID</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="paymentid"
                           asp-route-sortDirection="@(Model.SortColumn == "paymentid"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "paymentid")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>

                    <th style="width: 160px;"></th>                    
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>                    
                        <!-- Data -->
                        <td>@payment.Payment_Date.ToShortDateString()</td>
                        <td>@payment.Service.Customer.Cust_Name</td>
                        <td>@payment.Payment_Amount.ToString("c")</td>                       
                        <td>@payment.Payment_Method</td>
                        <td>@payment.Payment_ID.ToString("D8")</td> @*min of 8 digits*@
                                              

                        <!-- Actions (3-dot menu) -->
                        <td class="text-end">
                            @* <div class="dropdown">
                                <button class="btn btn-sm btn-link text-dark" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical  "></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                            asp-action="Edit"
                                            asp-route-id="@property.Property_ID">
                                            Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                            asp-action="Delete"
                                            asp-route-id="@property.Property_ID">
                                            Delete
                                        </a>
                                    </li>
                                </ul>
                            </div> *@
                            <div class="d-inline-flex align-items-center gap-3">
                                <a asp-action="Edit" asp-route-id="@payment.Payment_ID" class="text-muted" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>                                
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>    
</div>




