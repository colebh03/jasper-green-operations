@model PaymentViewModel

@{    
    string title = Model.Action + " Payment";
    ViewData["Title"] = title;
}

<div class="mx-auto" style="max-width: 900px;">
    <h2 class="mt-3 mb-3">@ViewData["Title"]</h2>

    <div class="card-box shadow-sm p-3 mx-auto" style="max-width: 900px;">
        <form asp-action="Save" method="post">                      
            <div class="row mb-2">
                <label asp-for="Payment.Payment_Amount"
                       class="col-md-3 col-form-label">

                    Payment Amount
                </label>

                <div class="col-md-7">

                    <div class="input-group">

                        <input asp-for="Payment.Payment_Amount"
                               class="form-control"
                               readonly />

                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                    </div>

                    <span asp-validation-for="Payment.Payment_Amount"
                          class="text-danger"></span>

                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Payment.Payment_Date" class="col-md-3 col-form-label">Payment Date</label>
                <div class="col-md-7">
                    <input asp-for="Payment.Payment_Date" class="form-control" type="date" />
                    <span asp-validation-for="Payment.Payment_Date" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Payment.Payment_Method" class="col-md-3 col-form-label">Payment Method</label>
                <div class="col-md-7">
                    <select asp-for="Payment.Payment_Method"
                            class="form-select"
                            asp-items="@(new SelectList(new[]
                            {
                                "Cash",
                                "Check"
                            }))">
                        <option value="">Select Payment Method</option>
                    </select>
                    <span asp-validation-for="Payment.Payment_Method" class="text-danger"></span>
                </div>
            </div>                      

            <input type="hidden" asp-for="Payment.Payment_ID" />
            <input type="hidden" asp-for="Payment.Service_ID" />

            <div class="mt-3">
                <button type="submit" class="btn btn-green">Save</button>
                <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>