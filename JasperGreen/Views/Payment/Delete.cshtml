============================================================================
AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      Delete.cshtml (Payment Delete Confirmation View)

PURPOSE:      Displays a confirmation page before deleting a Payment record.
              Ensures the user verifies the action before permanent removal.

INPUT:        - Payment model passed from the controller
              - Payment details (Customer, Date, Amount) for display

PROCESS:      - Displays key Payment information for user confirmation
              - Posts back to Delete action upon confirmation
              - Provides option to cancel and return to list

OUTPUT:       - Rendered confirmation page with Payment details
              - Form submission to delete record or cancel action

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model Payment

@{
    // Set the page title for display in the layout and browser tab.
    string title = "Delete Payment";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Confirm Deletion</h2>
</div>
    <!-- Warning message displayed prominently to alert the user -->
    <p class="bg-danger text-light p-3">
        Are you sure you want to delete the following payment from the database?
    </p>

    <!-- Display the property address so the user knows which record is affected -->
    <h3>@Model.Service.Customer.Cust_Name, @Model.Payment_Date.ToShortDateString()</h3>
    <h3>@Model.Payment_Amount.ToString("C")</h3>

    <!--
        The form posts to the Delete action method in the controller.
        A hidden field is used to pass the Property_ID so the correct record
        can be located and removed.
    -->
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Payment_ID" />

        <!-- Confirmation buttons: Delete (submits) or Cancel (returns to list) -->
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
    </form>
