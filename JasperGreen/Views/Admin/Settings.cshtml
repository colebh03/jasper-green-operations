@{
    ViewData["Title"] = "Admin Settings";
}

<div class="admin-dashboard">
    <section class="admin-settings-header mb-4">
        <div>
            <p class="admin-label">Admin Settings</p>
            <h1>Portal Controls</h1>
            <p>
                Review administrative access, public website entry points, and operational shortcuts for Jasper Green.
            </p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-success">
            <i class="bi bi-speedometer2 me-1"></i>
            Dashboard
        </a>
    </section>

    <div class="row g-4">
        <div class="col-lg-6">
            <section class="admin-panel h-100">
                <div class="admin-panel-heading">
                    <div>
                        <p class="admin-label">Security</p>
                        <h2>Identity and Roles</h2>
                    </div>
                    <span class="admin-pill">Admin only</span>
                </div>
                <p class="text-muted">
                    Manage users and administrator role assignments through the existing ASP.NET Identity user management screen.
                </p>
                <a asp-controller="User" asp-action="Index" class="btn btn-green">
                    <i class="bi bi-person-gear me-1"></i>
                    Manage Users
                </a>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="admin-panel h-100">
                <div class="admin-panel-heading">
                    <div>
                        <p class="admin-label">Public Website</p>
                        <h2>Customer-Facing Pages</h2>
                    </div>
                </div>
                <p class="text-muted">
                    Jump to the public Jasper Green website pages without leaving the application.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Home</a>
                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-success">About</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-success">Contact</a>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="admin-panel h-100">
                <div class="admin-panel-heading">
                    <div>
                        <p class="admin-label">Operations</p>
                        <h2>Core Records</h2>
                    </div>
                </div>
                <div class="admin-settings-links">
                    <a asp-controller="Customer" asp-action="List"><i class="bi bi-people-fill"></i> Customers</a>
                    <a asp-controller="Property" asp-action="List"><i class="bi bi-house-door-fill"></i> Properties</a>
                    <a asp-controller="Service" asp-action="List"><i class="bi bi-calendar2-check-fill"></i> Services</a>
                    <a asp-controller="Payment" asp-action="List"><i class="bi bi-credit-card-fill"></i> Payments</a>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="admin-panel h-100">
                <div class="admin-panel-heading">
                    <div>
                        <p class="admin-label">Staffing</p>
                        <h2>Crew Resources</h2>
                    </div>
                </div>
                <div class="admin-settings-links">
                    <a asp-controller="Employee" asp-action="List"><i class="bi bi-person-vcard-fill"></i> Employees</a>
                    <a asp-controller="Crew" asp-action="List"><i class="bi bi-diagram-3-fill"></i> Crews</a>
                    <a asp-controller="Admin" asp-action="Index"><i class="bi bi-activity"></i> Recent Activity</a>
                </div>
            </section>
        </div>
    </div>
</div>
