@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "About";
}

<section class="public-page-header reveal-on-scroll">
    <div class="container">
        <p class="public-eyebrow text-success">About Jasper Green</p>
        <h1>Grounded in dependable landscape care.</h1>
        <p>
            Jasper Green combines practical property maintenance with professional operations, giving customers a landscaping partner that values clean work, clear schedules, and long-term property health.
        </p>
    </div>
</section>

<section class="public-section reveal-on-scroll">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-6">
                <h2 class="public-section-title">A company built for reliable outdoor service.</h2>
                <p class="public-large-copy">
                    We serve residential and commercial customers who want their outdoor spaces to look cared for without having to chase details. Our crews focus on consistent maintenance, thoughtful enhancements, and respectful work around each property.
                </p>
                <p class="public-large-copy mt-3">
                    Jasper Green was shaped around a simple idea: great landscaping should feel organized from the first conversation through the final walkthrough. We pair hands-on property care with clear operations so customers know what is happening, when crews will arrive, and how each visit supports long-term curb appeal.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="public-highlight-list">
                    <div>
                        <i class="bi bi-check2-circle"></i>
                        <span>Routine lawn and landscape maintenance</span>
                    </div>
                    <div>
                        <i class="bi bi-check2-circle"></i>
                        <span>Seasonal planting, cleanup, and property refreshes</span>
                    </div>
                    <div>
                        <i class="bi bi-check2-circle"></i>
                        <span>Commercial and residential service coordination</span>
                    </div>
                    <div>
                        <i class="bi bi-check2-circle"></i>
                        <span>Organized crews supported by an internal operations portal</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="public-section public-section-soft reveal-on-scroll">
    <div class="container">
        <div class="public-section-heading">
            <div>
                <p class="public-eyebrow text-success">Why Jasper Green</p>
                <h2 class="public-section-title mb-0">The details that make service feel dependable.</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="public-value-card reveal-on-scroll">
                    <i class="bi bi-chat-dots-fill"></i>
                    <h3>Clear Communication</h3>
                    <p>We keep expectations plain, practical, and easy to follow from request to completed service.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="public-value-card reveal-on-scroll">
                    <i class="bi bi-calendar2-check-fill"></i>
                    <h3>Reliable Scheduling</h3>
                    <p>Recurring care plans and seasonal work are coordinated so your property does not drift.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="public-value-card reveal-on-scroll">
                    <i class="bi bi-geo-alt-fill"></i>
                    <h3>Local Property Focus</h3>
                    <p>Our recommendations are shaped around local lawns, heat, rain patterns, and property needs.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="public-section reveal-on-scroll">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5">
                <p class="public-eyebrow text-success">Our process</p>
                <h2 class="public-section-title">Simple steps, steady care.</h2>
                <p class="public-large-copy">
                    Every property has different pressure points. We start by listening, then build a service rhythm that fits the site, the season, and the way the property is used.
                </p>
            </div>
            <div class="col-lg-7">
                <div class="public-process-list">
                    <div class="reveal-on-scroll">
                        <span>01</span>
                        <div>
                            <h3>Walk the Property</h3>
                            <p>We review the lawn, beds, traffic areas, cleanup needs, and recurring maintenance goals.</p>
                        </div>
                    </div>
                    <div class="reveal-on-scroll">
                        <span>02</span>
                        <div>
                            <h3>Plan the Service</h3>
                            <p>We match your needs to mowing, bed work, cleanup, irrigation checks, or commercial care.</p>
                        </div>
                    </div>
                    <div class="reveal-on-scroll">
                        <span>03</span>
                        <div>
                            <h3>Keep It Moving</h3>
                            <p>Our team follows a clear schedule and adjusts recommendations as the season changes.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="public-section public-section-soft reveal-on-scroll">
    <div class="container">
        <div class="text-center mx-auto public-narrow-heading">
            <p class="public-eyebrow text-success">Values</p>
            <h2 class="public-section-title">How we want every visit to feel.</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="public-value-card reveal-on-scroll">
                    <i class="bi bi-shield-check"></i>
                    <h3>Dependable</h3>
                    <p>Customers should know when service is happening and what care their property received.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="public-value-card reveal-on-scroll">
                    <i class="bi bi-flower2"></i>
                    <h3>Thoughtful</h3>
                    <p>We shape each service around curb appeal, property use, and seasonal conditions.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="public-value-card reveal-on-scroll">
                    <i class="bi bi-people-fill"></i>
                    <h3>Professional</h3>
                    <p>Our work aims to feel orderly from the first conversation through the final cleanup.</p>
                </div>
            </div>
        </div>
    </div>
</section>
