@*
============================================================================
AUTHOR:       Cole Howell, Michael Hudgins
COURSE:       ISTM 415
PROGRAM:      _Layout.cshtml

PURPOSE:      Defines the shared administrator layout, navigation bar, footer,
              and overall page structure for Jasper Green operations pages.

INPUT:        ViewData, route data, authenticated user identity, and rendered
              content from individual views.

PROCESS:      Uses role-aware navigation to show public links, admin links, and
              authentication controls appropriate to the current user.

OUTPUT:       A consistent HTML structure for administrator portal pages.

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@{
    string c = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string a = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    bool isAdmin = User.IsInRole("Admin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JasperGreen</title>
    <link rel="icon" href="~/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Jasper Green Logo" style="height:40px;" />
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#siteNavbar"
                        aria-controls="siteNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="siteNavbar">
                    <ul class="navbar-nav me-auto">
                        @if (isAuthenticated && isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(c == "Admin" ? "active" : "")"
                                   asp-controller="Admin"
                                   asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "Customer" ? "active" : "")"
                                   asp-controller="Customer"
                                   asp-action="List">Customers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "Property" ? "active" : "")"
                                   asp-controller="Property"
                                   asp-action="List">Properties</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "Service" ? "active" : "")"
                                   asp-controller="Service"
                                   asp-action="List">Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "Employee" ? "active" : "")"
                                   asp-controller="Employee"
                                   asp-action="List">Employees</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "Crew" ? "active" : "")"
                                   asp-controller="Crew"
                                   asp-action="List">Crews</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "Payment" ? "active" : "")"
                                   asp-controller="Payment"
                                   asp-action="List">Payments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(c == "User" ? "active" : "")"
                                   asp-controller="User"
                                   asp-action="Index">Users</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-green" asp-controller="Account" asp-action="LogIn">Login</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle admin-user-menu"
                                   href="#"
                                   id="adminUserMenu"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminUserMenu">
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="LogOut">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right me-2"></i>
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item ms-lg-2">
                                    <a class="btn @(c == "Admin" && a == "Settings" ? "btn-green" : "btn-outline-success")"
                                       asp-controller="Admin"
                                       asp-action="Settings">
                                        <i class="bi bi-gear-fill me-1"></i>
                                        Settings
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy;&nbsp;@DateTime.Now.Year JasperGreen Operations
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
