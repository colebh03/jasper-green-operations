@*
============================================================================
AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      List.cshtml (Customer Manager View)

PURPOSE:      Displays a tabular list of all Customer records and provides
              navigation for adding, editing, and deleting customers.

INPUT:        List<Customer> containing customer data retrieved from the
              database.

PROCESS:      Iterates through the collection of Customer objects and renders
              each as a row in a responsive table with action controls.

OUTPUT:       HTML table displaying customer information with links to Edit
              and Delete actions for each record.

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model CustomerListViewModel
<!-- Error for deletion of customer when associated with service records or properties -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 mb-3 small rounded-3 shadow-sm text-center">
        @TempData["Error"]
    </div>
}

@if (TempData.Keys.Contains("message"))
{
    <div class="alert alert-success py-2 px-3 mb-3 small rounded-3 shadow-sm text-center">
        @TempData["message"]
    </div>
}


@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Customers</h2>              
    <a asp-action="Add" class="btn btn-green">+ Add Customer</a>
</div>

<div class="card-table shadow-sm p-0">
    <div class="table-responsive">
        <table class="table align-middle table-hover table-actions">
            <thead class="table-light">
                <tr>                
                    <th>
                        <span>Name</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="name"
                           asp-route-sortDirection="@(Model.SortColumn == "name" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "name")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>
                        <span>City</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="city"
                           asp-route-sortDirection="@(Model.SortColumn == "city" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "city")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>
                    <th style="width: 160px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>                    
                        <!-- Data -->
                        <td class="truncate" title="@customer.Cust_Name">@customer.Cust_Name</td>
                        <td>@customer.Cust_Phone</td>
                        <td>@customer.Cust_Email</td>
                        <td>@customer.Cust_Billing_City</td>

                        <!-- Actions (3-dot menu) -->
                        <td class="text-end">
                            @* <div class="dropdown">
                                <button class="btn btn-sm btn-link text-dark" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical  "></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                            asp-action="Edit"
                                            asp-route-id="@customer.Cust_ID">
                                            Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                            asp-action="Delete"
                                            asp-route-id="@customer.Cust_ID">
                                            Delete
                                        </a>
                                    </li>
                                </ul>
                            </div> *@
                            <div class="d-inline-flex align-items-center gap-3">
                                <a asp-action="Edit" asp-route-id="@customer.Cust_ID" class="text-muted" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@customer.Cust_ID" class="text-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>    
</div>




