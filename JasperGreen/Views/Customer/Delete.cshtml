AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      Delete.cshtml (Customer Delete Confirmation View)

PURPOSE:      Provides a confirmation interface for deleting a Customer
              record, ensuring the user explicitly confirms the action.

INPUT:        Customer object retrieved from the database containing the
              identifying information for the selected record.

PROCESS:      Displays the customer's name and prompts the user to confirm
              deletion via a POST request to the controller.

OUTPUT:       Form submission that results in deletion of the Customer record
              or cancellation returning to the list view.

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model Customer

@{
    // Set the page title for display in the layout and browser tab.
    string title = "Delete Customer";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Confirm Deletion</h2>
</div>
    <!-- Warning message displayed prominently to alert the user -->
    <p class="bg-danger text-light p-3">
        Are you sure you want to delete the following customer from the database?
    </p>

    <!-- Display the customers name so the user knows which record is affected -->
    <h3>@Model.Cust_Name</h3>

    <!--
        The form posts to the Delete action method in the controller.
        A hidden field is used to pass the CustomerID so the correct record
        can be located and removed.
    -->
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Cust_ID" />

        <!-- Confirmation buttons: Delete (submits) or Cancel (returns to list) -->
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
    </form>

