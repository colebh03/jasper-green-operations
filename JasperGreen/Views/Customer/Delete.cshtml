@model Customer

@{    
    string title = "Delete Customer";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Confirm Deletion</h2>
</div>    
<p class="bg-danger text-light p-3">
    Are you sure you want to delete the following customer from the database?
</p>
   
<h3>@Model.Cust_Name</h3>
    
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Cust_ID" />
        
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
</form>