@model Customer

@{    
    string title = ViewBag.Action + " Customer";
    ViewData["Title"] = title;
}

<div class="mx-auto" style="max-width: 900px;">
    <h2 class="mt-3 mb-3">@ViewBag.Title</h2>

    <div class="card-box shadow-sm p-3 mx-auto" style="max-width: 900px;">
        <form asp-action="Save" method="post">                      

            <div class="row mb-2">
                <label asp-for="Cust_Name" class="col-md-3 col-form-label">Full Name</label>
                <div class="col-md-7">
                    <input asp-for="Cust_Name" class="form-control" />           
                    <span asp-validation-for="Cust_Name" class="text-danger"></span>
                </div>
            </div>   

            <div class="row mb-2">
                <label asp-for="Cust_Billing_Address" class="col-md-3 col-form-label">Billing Address</label>
                <div class="col-md-7">
                    <input asp-for="Cust_Billing_Address" class="form-control" />
                    <span asp-validation-for="Cust_Billing_Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Cust_Billing_City" class="col-md-3 col-form-label">Billing City</label>
                <div class="col-md-7">
                    <input asp-for="Cust_Billing_City" class="form-control" />
                    <span asp-validation-for="Cust_Billing_City" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Cust_Billing_State" class="col-md-3 col-form-label">Billing State</label>
                <div class="col-md-7">
                    <select asp-for="Cust_Billing_State" asp-items="ViewBag.States" class="form-select">
                        <option value="">Select a state...</option>
                    </select>
                    <span asp-validation-for="Cust_Billing_State" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Cust_Billing_Zip" class="col-md-3 col-form-label">Billing ZIP Code</label>
                <div class="col-md-7">
                    <input asp-for="Cust_Billing_Zip" class="form-control" />
                    <span asp-validation-for="Cust_Billing_Zip" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Cust_Phone" class="col-md-3 col-form-label">Phone</label>
                <div class="col-md-7">
                    <input asp-for="Cust_Phone" class="form-control" />
                    <span asp-validation-for="Cust_Phone" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-2">
                <label asp-for="Cust_Email" class="col-md-3 col-form-label">Email</label>
                <div class="col-md-7">
                    <input asp-for="Cust_Email" class="form-control" />
                    <span asp-validation-for="Cust_Email" class="text-danger"></span>
                </div>
            </div>

            <input type="hidden" asp-for="Cust_ID" />

            <div class="mt-3">
                <button type="submit" class="btn btn-green">Save</button>
                <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>