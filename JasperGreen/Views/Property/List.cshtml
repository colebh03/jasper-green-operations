@*
============================================================================
AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      List.cshtml (Property Manager View)

PURPOSE:      Displays a tabular list of all Property records, including
              associated Customer data, and provides navigation for managing
              properties.

INPUT:        List<Property> containing property data and related Customer
              navigation properties retrieved from the database.

PROCESS:      Iterates through the collection of Property objects and renders
              each as a row in a responsive table with action controls.

OUTPUT:       HTML table displaying property details with links to Edit and
              Delete actions for each record.

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model PropertyListViewModel
<!-- Error for deletion of property when associated with service records -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Properties</h2>              
    <a asp-action="Add" class="btn btn-green">+ Add Property</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">

    <div class="dropdown">
        <button class="btn btn-green dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Filter
        </button>

        @if (!string.IsNullOrEmpty(Model.CurrentFilterText))
        {
            <div class="mt-2">
                <a asp-action="List" class="filter-tag">
                    <span>@Model.CurrentFilterText</span>
                    <i class="bi bi-x"></i>
                </a>
            </div>
        }

        <ul class="dropdown-menu">
            <li>
                <a class="dropdown-item" asp-action="GetCustomer">By Customer</a>
            </li>       

            <li><hr class="dropdown-divider"></li>

            <li>
                <a class="dropdown-item text-muted" asp-action="List">Show All</a>
            </li>
        </ul>
    </div>
</div>

<div class="card-table shadow-sm p-0">
    <div class="table-responsive">
        <table class="table align-middle table-hover table-actions">
            <thead class="table-light">
                <tr>                
                    <th>
                        <span>Property</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="property"
                           asp-route-sortDirection="@(Model.SortColumn == "property" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "property")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>
                    <th>
                        <span>Customer</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="customer"
                           asp-route-sortDirection="@(Model.SortColumn == "customer" && Model.SortDirection == "asc" ? "desc" : "asc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "customer")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>
                    <th>
                        <span>Service Fee</span>

                        <a asp-action="List"
                           asp-route-filter="@Model.Filter"
                           asp-route-id="@Model.Id"
                           asp-route-sortColumn="fee"
                           asp-route-sortDirection="@(Model.SortColumn == "fee"
                                ? (Model.SortDirection == "asc" ? "desc" : "asc")
                                : "desc")"
                           class="text-decoration-none ms-1 text-secondary px-1">

                            @if (Model.SortColumn == "fee")
                            {
                                if (Model.SortDirection == "asc")
                                {
                                    <i class="bi bi-caret-up-fill align-middle active-sort"></i>
                                }
                                else
                                {
                                    <i class="bi bi-caret-down-fill align-middle active-sort"></i>
                                }
                            }
                            else
                            {
                                <i class="bi bi-caret-down align-middle"></i>
                            }

                        </a>
                    </th>
                    <th style="width: 160px;"></th>                    
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model.Properties)
                {
                    <tr>                    
                        <!-- Data -->
                        <td class="truncate" title="@property.Property_Full_Address">@property.Property_Full_Address</td>
                        <td>@property.Customer.Cust_Name</td>
                        <td>@property.Property_Service_Fee.ToString("c")</td>                        

                        <!-- Actions (3-dot menu) -->
                        <td class="text-end">
                            @* <div class="dropdown">
                                <button class="btn btn-sm btn-link text-dark" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical  "></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                            asp-action="Edit"
                                            asp-route-id="@property.Property_ID">
                                            Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger"
                                            asp-action="Delete"
                                            asp-route-id="@property.Property_ID">
                                            Delete
                                        </a>
                                    </li>
                                </ul>
                            </div> *@
                            <div class="d-inline-flex align-items-center gap-3">
                                <a asp-action="Edit" asp-route-id="@property.Property_ID" class="text-muted" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@property.Property_ID" class="text-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>    
</div>




