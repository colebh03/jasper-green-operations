============================================================================
AUTHOR:       Cole Howell
COURSE:       ISTM 415
PROGRAM:      Delete.cshtml (Crew Delete Confirmation View)

PURPOSE:      Provides a confirmation interface for deleting a Crew record,
              ensuring the user verifies the action before permanent removal.

INPUT:        Crew object containing Foreman and Crew Member data retrieved
              from the database.

PROCESS:      Displays identifying Crew details and prompts the user to confirm
              deletion via a POST request to the controller.

OUTPUT:       Form submission that triggers deletion of the selected Crew
              record or cancellation returning to the list view.

HONOR CODE:   On my honor, as an Aggie, I have neither given nor received
              unauthorized aid on this academic work.
============================================================================
*@

@model Crew

@{
    // Set the page title for display in the layout and browser tab.
    string title = "Delete Crew";
    ViewData["Title"] = title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Confirm Deletion</h2>
</div>
    <!-- Warning message displayed prominently to alert the user -->
    <p class="bg-danger text-light p-3">
        Are you sure you want to delete the following crew from the database?
    </p>

    <!-- Display the crew foreman/members so the user knows which record is affected -->
    <h3>Foreman: @Model.Foreman.Emp_Full_Name</h3>
    <h3>Member 1: @Model.CrewMember1.Emp_Full_Name</h3>
    <h3>Member 2: @Model.CrewMember2.Emp_Full_Name</h3>

    <!--
        The form posts to the Delete action method in the controller.
        A hidden field is used to pass the Crew_ID so the correct record
        can be located and removed.
    -->
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Crew_ID" />

        <!-- Confirmation buttons: Delete (submits) or Cancel (returns to list) -->
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="List" class="btn btn-outline-secondary">Cancel</a>
    </form>
