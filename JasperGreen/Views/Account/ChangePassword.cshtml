@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="admin-login-page">
    <div class="admin-login-card">
        <div class="admin-login-intro">
            <p class="admin-label">Account Security</p>

            <h1>Change your password</h1>

            <p>
                Update the password for your Jasper Green Operations account.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Username))
            {
                <p class="mt-3">
                    Signed in as
                    <strong>@Model.Username</strong>
                </p>
            }
        </div>

        <form method="post"
              asp-controller="Account"
              asp-action="ChangePassword"
              class="admin-login-form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="OldPassword" class="form-label">
                    Current Password
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock-fill"></i>
                    </span>

                    <input asp-for="OldPassword"
                           type="password"
                           class="form-control"
                           autocomplete="current-password" />
                </div>

                <span asp-validation-for="OldPassword"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">
                    New Password
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-key-fill"></i>
                    </span>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />
                </div>

                <span asp-validation-for="NewPassword"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm New Password
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-shield-lock-fill"></i>
                    </span>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger small">
                </span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-green btn-lg">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Update Password
                </button>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>